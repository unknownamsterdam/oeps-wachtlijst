{
  // OEPS! website op Cloudflare. Bouwen: npm run build (Astro maakt dist/), live zetten: npx wrangler deploy.
  "name": "oeps-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/aanmelden", "/aanmelden/"]
  },
  // BREVO_LIST_ID: de lijst "OEPS! wachtlijst" in Brevo. MELDING_AAN: wie een seintje krijgt per aanmelding.
  "vars": { "BREVO_LIST_ID": "3", "MELDING_AAN": "joelmombarg@gmail.com" },
  "observability": { "enabled": true }
  // Geheim (niet in deze file): BREVO_API_KEY, als secret in Cloudflare.
}
