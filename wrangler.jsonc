{
  // OEPS! website op Cloudflare. Bouwen: npm run build (Astro maakt dist/), live zetten: npx wrangler deploy.
  // Gekoppeld aan Cloudflare Builds (project oeps-site). Draait op oeps.app en www.oeps.app.
  "name": "oeps-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/", "/inloggen", "/inloggen/", "/api/*", "/app", "/app/*", "/aanmelden", "/aanmelden/",
      "/app.css", "/app.js", "/sw.js", "/manifest.webmanifest", "/icon.svg", "/icon-180.png", "/icon-192.png", "/app-512.png"]
  },
  // BREVO_LIST_ID: de lijst "OEPS! wachtlijst" in Brevo. MELDING_AAN: wie een seintje krijgt per aanmelding.
  "vars": { "BREVO_LIST_ID": "3", "MELDING_AAN": "joelmombarg@gmail.com" },
  // Aanmeldingen gaan via oeps-mail (die heeft de Brevo-sleutel), niet rechtstreeks naar Brevo.
  // De app (oeps.app als je bent ingelogd, en oeps.app/inloggen) draait ook in oeps-mail: binding APP stuurt die verzoeken door.
  "services": [
    { "binding": "MAIL", "service": "oeps-mail", "entrypoint": "Wachtlijst" },
    { "binding": "APP", "service": "oeps-mail" }
  ],
  "observability": { "enabled": true }
}
