---
// Kleine, vrolijke illustraties per onderwerp. Eén plek, overal te gebruiken.
const { naam, grootte = 120 } = Astro.props;
const lijn = '#14213D';
---
<svg class="plaatje" width={grootte} height={grootte} viewBox="0 0 120 120" aria-hidden="true" fill="none" stroke={lijn} stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
  {naam === 'doos' && (
    <g>
      <path d="M24 46 L60 32 L96 46 L96 86 L60 100 L24 86 Z" fill="#F4C98A" />
      <path d="M24 46 L60 60 L96 46" />
      <path d="M60 60 L60 100" />
      <path d="M42 39 L78 53 L78 66" fill="none" />
      <path d="M86 20 C 100 22, 106 34, 100 44" />
      <path d="M95 14 L86 20 L94 27" />
      <circle cx="34" cy="70" r="2.5" fill={lijn} stroke="none" />
      <circle cx="46" cy="75" r="2.5" fill={lijn} stroke="none" />
      <path d="M36 82 C 39 86, 43 86, 46 84" />
    </g>
  )}
  {naam === 'wasmachine' && (
    <g>
      <rect x="28" y="22" width="64" height="80" rx="10" fill="#FFFFFF" />
      <path d="M28 40 L92 40" />
      <circle cx="40" cy="31" r="3" fill={lijn} stroke="none" />
      <circle cx="51" cy="31" r="3" fill={lijn} stroke="none" />
      <circle cx="60" cy="70" r="20" fill="#BFE3F5" />
      <path d="M48 70 C 54 64, 60 76, 72 68" />
      <g transform="rotate(-30 60 70)">
        <rect x="40" y="64" width="40" height="13" rx="6" fill="#FFD23F" />
        <path d="M56 67 L56 74 M64 67 L64 74" stroke-width="2.5" />
      </g>
      <path d="M100 24 L106 18 M102 34 L110 33 M18 30 L12 25" />
    </g>
  )}
  {naam === 'kalender' && (
    <g>
      <rect x="22" y="28" width="68" height="66" rx="10" fill="#FFFFFF" />
      <path d="M22 46 L90 46" />
      <rect x="22" y="28" width="68" height="18" rx="9" fill="#B9A8F5" />
      <path d="M38 22 L38 34 M74 22 L74 34" />
      <path d="M34 58 L40 58 M50 58 L56 58 M66 58 L72 58 M34 70 L40 70 M50 70 L56 70" />
      <circle cx="69" cy="70" r="6" fill="#FFD23F" />
      <path d="M96 66 C 106 76, 100 96, 82 100" />
      <path d="M90 94 L82 100 L90 106" />
    </g>
  )}
  {naam === 'prijskaartje' && (
    <g>
      <path d="M30 44 L60 22 L94 22 L94 56 L64 86 Z" fill="#FFD23F" transform="rotate(10 62 54)" />
      <circle cx="82" cy="34" r="5" fill="#FFFFFF" />
      <path d="M50 56 C 46 50, 56 46, 60 52 C 64 58, 54 62, 58 68 C 61 72, 68 70, 68 66 M56 46 L58 42 M58 72 L60 76" />
      <path d="M22 100 L22 66" />
      <path d="M12 76 L22 64 L32 76" />
      <path d="M100 100 L60 100" stroke-dasharray="1 9" />
    </g>
  )}
  {naam === 'brief' && (
    <g>
      <rect x="20" y="34" width="80" height="56" rx="8" fill="#FFFFFF" />
      <path d="M22 38 L60 66 L98 38" />
      <circle cx="92" cy="34" r="12" fill="#FFD23F" />
      <path d="M92 28 L92 35 M92 40 L92 40.5" />
    </g>
  )}
</svg>
