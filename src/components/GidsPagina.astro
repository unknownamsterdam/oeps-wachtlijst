---
// 14 okt: één zoekpagina uit de bedrijvengids. soort 'retour' (webwinkel) of 'opzeggen' (abonnement).
// 22 okt: ook in het Engels (/en/returns/<slug>/ en /en/cancel/<slug>/); de Engelse gegevens komen uit gids-en.js.
import Base from '../layouts/Base.astro';
import Plaatje from './Plaatje.astro';
import Wachtlijst from './Wachtlijst.astro';
import { SITE } from '../data/site.js';
import { RETOUR, OPZEGGEN, VIA, MANIER, RETOUR_EN, OPZEGGEN_EN, VIA_EN, MANIER_EN, gidsPad, heeftEngels } from '../data/gids.js';
import { GARANTIE } from '../data/garantie.js';
import { PAD, TEKST, datum } from '../i18n.js';

const { p, taal = 'nl' } = Astro.props;
const en = taal === 'en';
const T = TEKST[taal];
const retour = p.soort === 'retour';
const r = p.retour || {}, o = p.opzeggen || {};
const pad = gidsPad(p.soort, p.slug, taal);
const andere = en ? gidsPad(p.soort, p.slug, 'nl') : (heeftEngels(p.soort, p.slug) ? gidsPad(p.soort, p.slug, 'en') : null);
const zin = (x) => x.replace(/\.$/, '');
const stappenZin = (a) => a.map((x, i) => `${i + 1}. ${zin(x)}.`).join(' ');
const kosten = r.kosten ? zin(r.kosten) : null;
const X = en ? {
  titel: retour ? `${p.naam} return period` : `Cancel ${p.naam}`,
  seoTitel: retour ? `${p.naam} return period: how long can you send it back? | OEPS!` : `How to cancel ${p.naam}: step by step | OEPS!`,
  termijn: r.dagen ? `${r.dagen} days${r.vanaf === 'levering' ? ' after delivery' : r.vanaf === 'aankoop' ? ' after you order' : ''}` : null,
  via: VIA_EN[o.via] || 'in your account', manier: MANIER_EN, kruimel: retour ? 'Return periods' : 'Cancel a subscription',
  terug: 'How to send it back', opzeg: 'How to cancel', manieren: 'Ways to send it back',
  naarGarantie: `Something broken? See the ${p.naam} warranty ›`, naarLink: retour ? `Go to the ${p.naam} returns page` : `Go to ${p.naam}`,
  wet: 'If you order online, Dutch law gives you at least 14 days to change your mind after delivery. Many shops give you more time, as shown above.',
  blokKop: retour ? 'Never just too late again.' : 'Never stuck for another year again.',
  blok: retour ? 'OEPS! remembers the return period of every order and gives you a nudge before it ends. You don’t have to keep track of anything.' : `OEPS! keeps track of your subscriptions and gives you a nudge before ${p.naam} renews or gets more expensive.`,
  meer: retour ? 'Other return periods' : 'Cancel other subscriptions', mini: (x) => (retour ? `${x.naam} return period` : `Cancel ${x.naam}`),
  nlKnoppen: `These steps are for ${p.naam}’s Dutch website. Buttons and menus are named in Dutch there; the English meaning is in brackets.`,
} : {
  titel: retour ? `Retourtermijn ${p.naam}` : `${p.naam} opzeggen`,
  seoTitel: retour ? `Retourtermijn ${p.naam}: hoe lang kun je terugsturen? | OEPS!` : `${p.naam} opzeggen: zo doe je het | OEPS!`,
  termijn: r.dagen ? `${r.dagen} dagen${r.vanaf === 'levering' ? ' na ontvangst' : r.vanaf === 'aankoop' ? ' na je bestelling' : ''}` : null,
  via: VIA[o.via] || 'via je account', manier: MANIER, kruimel: retour ? 'Retourtermijnen' : 'Opzeggen',
  terug: 'Zo stuur je het terug', opzeg: 'Zo zeg je op', manieren: 'Manieren om terug te sturen',
  naarGarantie: `Iets kapot? Bekijk de garantie van ${p.naam} ›`, naarLink: retour ? `Naar de retourpagina van ${p.naam}` : `Naar ${p.naam}`,
  wet: 'Bestel je online, dan heb je volgens de wet minstens 14 dagen bedenktijd na ontvangst. Veel winkels geven meer tijd, zoals hierboven.',
  blokKop: retour ? 'Nooit meer net te laat.' : 'Nooit meer een jaar te lang vast.',
  blok: retour ? `OEPS! onthoudt de retourtermijn van elke bestelling en geeft je een seintje voordat hij afloopt. Jij hoeft niets bij te houden.` : `OEPS! houdt je abonnementen bij en geeft je een seintje voordat ${p.naam} verlengt of duurder wordt.`,
  meer: retour ? 'Andere retourtermijnen' : 'Andere abonnementen opzeggen', mini: (x) => (retour ? `Retourtermijn ${x.naam}` : `${x.naam} opzeggen`),
  nlKnoppen: null,
};
const { titel, seoTitel, termijn } = X;
const kort = en
  ? (retour
      ? (termijn ? `At ${p.naam} you have ${termijn} to send something back.${kosten ? ` Return costs: ${kosten}.` : ''}` : `Here’s how to send something back to ${p.naam}.`)
      : `You cancel ${p.naam} ${X.via}.${o.let_op ? ' ' + zin(o.let_op) + '.' : ''}`)
  : (retour
      ? (termijn ? `Bij ${p.naam} heb je ${termijn} om iets terug te sturen.${r.kosten ? ` Retourkosten: ${r.kosten.replace(/\.$/, '')}.` : ''}` : `Zo stuur je iets terug naar ${p.naam}.`)
      : `Je zegt ${p.naam} op ${X.via}.${o.let_op ? ' ' + o.let_op : ''}`);
const beschrijving = en
  ? (retour
      ? `${termijn ? `You have ${termijn} to send your ${p.naam} order back.` : `How to send your ${p.naam} order back.`} Steps, costs and a nudge before it’s too late.`
      : `How to cancel ${p.naam} in a few steps. Plus: what to watch out for so you’re not stuck for another period.`)
  : (retour
      ? `${termijn ? `Je hebt ${termijn} om je bestelling bij ${p.naam} terug te sturen.` : `Zo stuur je je bestelling bij ${p.naam} terug.`} Stappen, kosten en een seintje voordat het te laat is.`
      : `Zo zeg je ${p.naam} op, in een paar stappen. Plus: waar je op moet letten zodat je niet nog een periode vastzit.`);
const stappen = retour ? r.stappen : o.stappen;
const link = retour ? r.url : o.url;
const lijstIn = en ? (retour ? RETOUR_EN : OPZEGGEN_EN) : (retour ? RETOUR : OPZEGGEN);
const meer = lijstIn.filter((x) => x.slug !== p.slug).slice(0, 6);
const gecontroleerd = datum(p.bijgewerkt, taal);
const contactTel = p.contact && p.contact.telefoon;
// Vragen en antwoorden: alleen wat in de gids staat, in gewone zinnen. Staan ook zichtbaar op de pagina (schema moet daarmee kloppen).
const vragen = en
  ? (retour
    ? [
        termijn && { v: `How long can you send something back to ${p.naam}?`, a: `At ${p.naam} you have ${termijn} to send your order back.` },
        kosten && { v: `What does it cost to return something to ${p.naam}?`, a: /^free/i.test(kosten) ? `Returning to ${p.naam} is free.` : `Return costs at ${p.naam}: ${kosten}.` },
        stappen.length > 0 && { v: `How do you send something back to ${p.naam}?`, a: stappenZin(stappen) },
        { v: `What if the ${p.naam} return period has ended?`, a: `Then you usually can’t just send it back anymore. If the product is broken or not as described, you can still rely on the warranty. Contact ${p.naam} and explain what’s wrong.` },
      ]
    : [
        { v: `How do you cancel ${p.naam}?`, a: `You cancel ${p.naam} ${X.via}. ${stappenZin(stappen)}` },
        o.let_op && { v: `What should you watch out for when cancelling ${p.naam}?`, a: zin(o.let_op) + '.' },
        { v: `How do you avoid cancelling ${p.naam} too late?`, a: `Put the cancellation date in your calendar, or let an app like OEPS! give you a nudge before the subscription renews.` },
      ])
  : (retour
    ? [
        termijn && { v: `Hoe lang kun je terugsturen bij ${p.naam}?`, a: `Bij ${p.naam} heb je ${termijn} om je bestelling terug te sturen.` },
        kosten && { v: `Wat kost retourneren bij ${p.naam}?`, a: /^gratis/i.test(kosten) ? `Retourneren bij ${p.naam} is gratis.` : `Retourkosten bij ${p.naam}: ${kosten}.` },
        stappen.length > 0 && { v: `Hoe stuur je iets terug naar ${p.naam}?`, a: stappenZin(stappen) },
        { v: `Wat als de retourtermijn van ${p.naam} voorbij is?`, a: `Dan kun je meestal niet meer zomaar terugsturen. Is het product kapot of niet zoals beschreven, dan kun je nog wel een beroep doen op garantie. Neem contact op met ${p.naam} en leg uit wat er aan de hand is.` },
      ]
    : [
        { v: `Hoe zeg je ${p.naam} op?`, a: `Je zegt ${p.naam} op ${X.via}. ${stappenZin(stappen)}` },
        o.let_op && { v: `Waar moet je op letten bij het opzeggen van ${p.naam}?`, a: o.let_op },
        { v: `Hoe voorkom je dat je ${p.naam} te laat opzegt?`, a: `Zet de opzegdatum in je agenda of laat een app als OEPS! je een seintje geven voordat het abonnement verlengt.` },
      ]);
const faq = vragen.filter(Boolean);
const lijstPad = PAD[taal][retour ? 'retour' : 'opzeggen'];
const garantiePad = en ? `/en/warranty/${p.slug}/` : `/garantie/${p.slug}/`;
const lang = en ? 'en' : 'nl-NL';
const schema = [
  { '@type': 'WebPage', '@id': SITE.url + pad + '#pagina', url: SITE.url + pad, name: seoTitel.replace(' | OEPS!', ''), description: beschrijving, inLanguage: lang, dateModified: p.bijgewerkt, isPartOf: { '@id': SITE.url + '/#website' }, publisher: { '@id': SITE.url + '/#organization' } },
  { '@type': 'HowTo', name: titel, description: beschrijving, inLanguage: lang, step: stappen.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, text: s })) },
  { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.v, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + PAD[taal].home },
    { '@type': 'ListItem', position: 2, name: X.kruimel, item: SITE.url + lijstPad },
    { '@type': 'ListItem', position: 3, name: titel, item: SITE.url + pad } ] },
];
---
<Base title={seoTitel} description={beschrijving} schema={schema} taal={taal} andere={andere}>
  <article class="gids">
    <div class={`kopblok bg-${retour ? 'mint' : 'geel'}`}>
      <div class="wrap smal kopblok-in">
        <div>
          <nav class="kruimel" aria-label={T.kruimel}><a href={lijstPad}>{X.kruimel}</a> <span>›</span> {p.naam}</nav>
          <h1>{titel}</h1>
        </div>
        <Plaatje naam={retour ? 'doos' : 'kalender'} grootte={130} />
      </div>
    </div>
    <div class="wrap smal">
      <div class="kort"><span class="kort-label">{T.kortGezegd}</span><p>{kort}</p><p class="gecontroleerd">{T.gecontroleerdOp} {gecontroleerd}{p.bron && <> · {T.bron}: <a href={p.bron} rel="noopener nofollow" target="_blank">{T.siteVan(p.naam)}</a></>}</p></div>
      {stappen.length > 0 && (<section class="tekst"><h2>{retour ? X.terug : X.opzeg}</h2><ol>{stappen.map((s) => <li>{s}</li>)}</ol>{X.nlKnoppen && <p class="wet">{X.nlKnoppen}</p>}</section>)}
      {retour && r.manieren?.length > 0 && (<section class="tekst"><h2>{X.manieren}</h2><ul>{r.manieren.map((m) => <li>{X.manier[m] || m}</li>)}</ul></section>)}
      {retour && GARANTIE.some((x) => x.slug === p.slug) && <p class="naar"><a href={garantiePad}>{X.naarGarantie}</a></p>}
      {link && <p class="naar"><a href={link} rel="noopener nofollow" target="_blank">{X.naarLink} ›</a></p>}
      <section class="tekst vragen"><h2>{T.veelgesteld}</h2>
        {faq.map((f) => (<details><summary>{f.v}</summary><p>{f.a}</p></details>))}
      </section>
      {retour && <p class="wet">{X.wet}</p>}
      <aside class="oeps-blok">
        <div><span class="badge">{T.binnenkort}</span>
          <h2>{X.blokKop}</h2>
          <p>{X.blok}</p></div>
        <Wachtlijst compact bron={(retour ? 'retour-' : 'opzeggen-') + p.slug} taal={taal} />
      </aside>
      <footer class="info">
        <p>{T.opgezocht(p.naam)} · {T.bijgewerktOp} {gecontroleerd}{p.bron && <> · <a href={p.bron} rel="noopener nofollow" target="_blank">{T.bron}</a></>}</p>
        <p>{T.kloptNiet} <a href={`mailto:${SITE.mail}`}>{SITE.mail}</a>, {T.kloptNiet2(p.naam)}</p>
      </footer>
      {meer.length > 0 && (<section class="meer"><h2>{X.meer}</h2>
        <div class="meer-lijst">{meer.map((x) => <a class="mini" href={gidsPad(x.soort, x.slug, taal)}>{X.mini(x)}</a>)}</div></section>)}
    </div>
  </article>
</Base>
<style>
  .kopblok{padding:28px 0 46px;margin-bottom:-22px}
  .kopblok-in{display:flex;align-items:center;gap:20px;justify-content:space-between}
  .kopblok h1{font-size:clamp(32px,5.4vw,50px)}
  .kruimel{font-size:14px;font-weight:600;margin-bottom:12px}
  .kruimel a{text-decoration:none;opacity:.8}
  .kruimel span{opacity:.5;margin:0 4px}
  .kort{position:relative;background:var(--wit);border-radius:var(--rond);box-shadow:var(--schaduw);padding:24px 24px 22px;border:3px solid var(--marine)}
  .kort-label{position:absolute;top:-14px;left:20px;background:var(--geel);font-weight:800;font-stretch:112%;font-size:14px;padding:3px 12px;border-radius:999px;border:3px solid var(--marine)}
  .kort p{font-size:20px;line-height:1.45;font-weight:600}
  .tekst{margin-top:32px;font-size:18px}
  .tekst h2{margin:0 0 12px}
  .tekst ol,.tekst ul{margin:12px 0;padding-left:0;list-style:none;display:grid;gap:10px}
  .tekst li{background:var(--wit);border-radius:14px;padding:12px 16px 12px 48px;position:relative}
  .tekst ul li::before{content:"";position:absolute;left:18px;top:19px;width:12px;height:12px;border-radius:50%;background:var(--geel);border:2.5px solid var(--marine)}
  .tekst ol{counter-reset:stap}
  .tekst ol li{counter-increment:stap}
  .tekst ol li::before{content:counter(stap);position:absolute;left:12px;top:11px;width:26px;height:26px;border-radius:50%;background:var(--marine);color:var(--wit);font-weight:800;font-size:14px;display:grid;place-items:center}
  .naar{margin-top:18px;font-weight:700}
  .kort .gecontroleerd{font-size:14px;font-weight:500;color:var(--zacht);margin-top:10px}
  .vragen details{background:var(--wit);border-radius:14px;padding:0;margin-top:10px}
  .vragen summary{cursor:pointer;font-weight:700;padding:14px 18px;list-style:none;font-size:17px}
  .vragen summary::-webkit-details-marker{display:none}
  .vragen summary::after{content:"+";float:right;font-weight:800}
  .vragen details[open] summary::after{content:"–"}
  .vragen details p{padding:0 18px 16px;font-size:16px;color:var(--zacht)}
  .wet{margin-top:14px;font-size:15px;color:var(--zacht)}
  .oeps-blok{margin:28px 0 0;background:var(--marine);color:var(--wit);border-radius:var(--rond);padding:26px;display:grid;gap:18px}
  .oeps-blok h2{color:var(--wit);margin:10px 0 6px}
  .oeps-blok p{color:#d6dbe5}
  .badge{display:inline-block;background:var(--geel);color:var(--marine);font-weight:800;font-size:13px;padding:3px 10px;border-radius:999px}
  .oeps-blok :global(label){color:var(--wit)}
  .oeps-blok :global(.klein){color:#aab3c5}
  .oeps-blok :global(.formulier button){background:var(--geel);color:var(--marine)}
  .info{margin-top:30px;font-size:14px;color:var(--zacht);display:grid;gap:4px}
  .meer{margin-top:40px}
  .meer h2{margin-bottom:14px}
  .meer-lijst{display:grid;gap:10px}
  .mini{display:block;padding:12px 16px;border-radius:16px;background:var(--wit);text-decoration:none;font-weight:700;font-size:17px}
  @media (max-width:640px){.kopblok-in{flex-direction:column-reverse;align-items:flex-start;gap:4px}.kopblok :global(.plaatje){width:90px;height:90px}.tekst{font-size:17px}.kort p{font-size:18px}}
</style>
