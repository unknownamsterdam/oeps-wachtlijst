---
// 14 nov (Joël): bewegende telefoon op de homepage. Zes korte stappen: mailbox, mail wordt kaart, je huishouden,
// seintje bij retour, garantie na twee jaar, overzicht. Ontwerp: artifact "OEPS! homepage-animatie v2".
// Winkels en afzenders zijn verzonnen. Staat beweging uit op het toestel, dan staat het beeld stil en tik je zelf door.
const { taal = 'nl' } = Astro.props;
const T = {
  nl: {
    kop: 'Kijk hoe het gaat', label: 'Animatie: zo werkt OEPS!',
    mailbox: 'Je mailbox', huishouden: 'Je huishouden', aankopen: 'Aankopen', nu: 'Nu', overzicht: 'Overzicht', pakketten: 'Pakketten', account: 'Account',
    mails: [['Huis & Keuken', 'Je bestelling is gelukt!', 'aankoop'], ['Modehuis', '50% korting, alleen vandaag', ''], ['Waterbedrijf', 'Tarieven 2027', 'prijs'], ['Pakketdienst', 'Je pakket komt morgen', 'pakket'], ['Nieuwsbrief', '10 tips voor de herfst', ''], ['Sportschool', 'Je abonnement wordt verlengd', 'abonnement']],
    tegels: [['Retour', 'Jas mag nog 2 dagen terug'], ['Garantie', 'Wasmachine tot maart 2027'], ['Abonnement', 'Streaming wordt €2 duurder'], ['Rekening', 'Energie betalen vóór vrijdag'], ['Pakket', 'Komt morgen tussen 10 en 12'], ['Auto', 'APK over 5 weken']],
    winkel: 'Huis & Keuken', product: 'Espressomachine', prijs: 'Prijs', bedrag: '€249,00', retourTot: 'Retour tot', retourDag: '12 dec', garantieTot: 'Garantie tot', garantieDag: '14 nov 2028',
    mailOnd: 'Je bestelling is gelukt!',
    nog2: 'Nog 2 dagen terugsturen', houden: 'Houden', terug: 'Terugsturen', blijft: 'Top, hij blijft!', controle: 'Alles onder controle.',
    nog30: 'Nog 30 dagen garantie', werkt: 'Werkt je espressomachine nog goed?', ja: 'Ja', nee: 'Nee', bon: 'Je bon staat klaar. Zal ik de mail voor de winkel maken?', maak: 'Maak de mail',
    bonnen: 'Bonnen bewaard', inGarantie: '19 nog in garantie', bespaard: 'Bespaard', perJaar: 'per jaar', rust: 'Alles onder controle', niets: 'Niets waar je nu iets mee hoeft.',
    stap: 'Stap', pauze: 'Pauze', afspelen: 'Afspelen',
    teksten: ['OEPS! leest mee in je mail. Reclame blijft liggen.', 'Uit elke mail haalt OEPS! wat belangrijk is.', 'Aankopen, abonnementen, rekeningen, pakketten en je auto.', 'Op het juiste moment een seintje. Jij kiest.', 'Twee jaar later weet OEPS! het nog.', 'Leg het één keer vast. Wij onthouden de rest.'],
    datums: { start: 'vr 14 nov', loop: ['ma 17 nov', 'vr 21 nov', 'do 27 nov', 'wo 3 dec', 'ma 8 dec', 'vr 12 dec'], later: 'ma 13 nov 2028', nu: 'vandaag' },
    komma: ',',
  },
  en: {
    kop: 'See how it goes', label: 'Animation: how OEPS! works',
    mailbox: 'Your inbox', huishouden: 'Your household', aankopen: 'Purchases', nu: 'Now', overzicht: 'Overview', pakketten: 'Parcels', account: 'Account',
    mails: [['Home & Kitchen', 'Your order is confirmed!', 'purchase'], ['Fashion House', '50% off, today only', ''], ['Water company', 'Rates for 2027', 'price'], ['Parcel service', 'Your parcel arrives tomorrow', 'parcel'], ['Newsletter', '10 tips for autumn', ''], ['Gym', 'Your membership will renew', 'subscription']],
    tegels: [['Return', 'Coat can go back for 2 more days'], ['Warranty', 'Washing machine until March 2027'], ['Subscription', 'Streaming goes up by €2'], ['Bill', 'Pay energy before Friday'], ['Parcel', 'Arrives tomorrow, 10 to 12'], ['Car', 'MOT due in 5 weeks']],
    winkel: 'Home & Kitchen', product: 'Espresso machine', prijs: 'Price', bedrag: '€249.00', retourTot: 'Return by', retourDag: '12 Dec', garantieTot: 'Warranty until', garantieDag: '14 Nov 2028',
    mailOnd: 'Your order is confirmed!',
    nog2: '2 days left to return', houden: 'Keep', terug: 'Return', blijft: 'Great, it stays!', controle: 'Everything under control.',
    nog30: '30 days of warranty left', werkt: 'Is your espresso machine still working well?', ja: 'Yes', nee: 'No', bon: 'Your receipt is ready. Shall I write the email to the shop?', maak: 'Write the email',
    bonnen: 'Receipts saved', inGarantie: '19 still under warranty', bespaard: 'Saved', perJaar: 'per year', rust: 'Everything under control', niets: 'Nothing you need to do right now.',
    stap: 'Step', pauze: 'Pause', afspelen: 'Play',
    teksten: ['OEPS! reads along in your mail. Ads stay where they are.', 'OEPS! takes what matters from every email.', 'Purchases, subscriptions, bills, parcels and your car.', 'A heads-up at the right moment. You choose.', 'Two years later, OEPS! still remembers.', 'Save it once. We remember the rest.'],
    datums: { start: 'Fri 14 Nov', loop: ['Mon 17 Nov', 'Fri 21 Nov', 'Thu 27 Nov', 'Wed 3 Dec', 'Mon 8 Dec', 'Fri 12 Dec'], later: 'Mon 13 Nov 2028', nu: 'today' },
    komma: '.',
  },
}[taal];
const js = JSON.stringify({ teksten: T.teksten, datums: T.datums, komma: T.komma, pauze: T.pauze, afspelen: T.afspelen });
---
<div class="oa-blok">
    <h2>{T.kop}</h2>
    <div class="oa" id="oa-podium" data-scene="inbox" data-js={js} aria-label={T.label}>
      <div class="telefoon">
        <div class="scherm">
          <div class="status"><span>9:41</span><span class="datum" id="oa-datum">{T.datums.start}</span></div>

          <section class="sc scA" aria-hidden="true">
            <h3>{T.mailbox}</h3>
            {T.mails.map(([van, ond, tag]) => <div class={tag ? 'mrij pak' : 'mrij laat'}><b>{van}</b><span class="ond">{ond}</span>{tag && <span class="tag">{tag}</span>}</div>)}
          </section>

          <section class="sc scB" aria-hidden="true">
            <h3>{T.huishouden}</h3>
            <div class="tegels">
              {T.tegels.map(([wie, wat]) => <div class="tegel"><span class="wie">{wie}</span><b>{wat}</b></div>)}
            </div>
          </section>

          <section class="sc sc1" aria-hidden="true">
            <h3>{T.aankopen}</h3>
            <div class="oa-kaart nieuw">
              <span class="wie veld v1">{T.winkel}</span>
              <span class="wat veld v2">{T.product}</span>
              <div class="rij prijs veld v3"><span>{T.prijs}</span><b>{T.bedrag}</b></div>
              <div class="rij veld v4"><span>{T.retourTot}</span><b>{T.retourDag}</b></div>
              <div class="rij veld v5"><span>{T.garantieTot}</span><b>{T.garantieDag}</b></div>
            </div>
            <div class="grijsrij"></div>
            <div class="grijsrij"></div>
          </section>

          <section class="sc sc2" aria-hidden="true">
            <h3>{T.nu}</h3>
            <div class="oa-kaart vraag">
              <span class="wie">{T.winkel}</span>
              <div class="kopje">{T.nog2}</div>
              <span class="oa-klein">{T.product} · {T.bedrag}</span>
              <div class="knoppen"><span class="kn gekozen">{T.houden}<i class="tik"></i></span><span class="kn">{T.terug}</span></div>
              <div class="klaar"><div><div class="vinkje">✓</div>{T.blijft}<span>{T.controle}</span></div></div>
            </div>
            <div class="grijsrij"></div>
          </section>

          <section class="sc sc3" aria-hidden="true">
            <h3>{T.nu}</h3>
            <div class="oa-kaart vraag">
              <span class="wie">{T.winkel}</span>
              <div class="kopje">{T.nog30}</div>
              <span class="oa-klein">{T.werkt}</span>
              <div class="knoppen"><span class="kn">{T.ja}</span><span class="kn gekozen">{T.nee}<i class="tik"></i></span></div>
            </div>
            <div class="bel">{T.bon}<span class="kn">{T.maak}</span></div>
          </section>

          <section class="sc sc4" aria-hidden="true">
            <h3>{T.overzicht}</h3>
            <div class="stand"><span class="oa-klein">{T.bonnen}</span><span class="bedrag">144</span><span class="oa-klein">{T.inGarantie}</span></div>
            <div class="bespaard"><span class="oa-klein">{T.bespaard}</span><span class="bedrag" id="oa-teller">€231{T.komma}36</span><span class="oa-klein">{T.perJaar}</span></div>
            <div class="oa-kaart rustig" style="text-align:center"><div class="vinkje">✓</div><b>{T.rust}</b><span class="oa-klein">{T.niets}</span></div>
          </section>

          <div class="tabs" aria-hidden="true">
            <span class="tab t-nu"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>{T.nu}</span>
            <span class="tab t-ov"><svg viewBox="0 0 24 24"><path d="M5 7h14M5 12h14M5 17h9"/></svg>{T.overzicht}</span>
            <span class="tab"><svg viewBox="0 0 24 24"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/></svg>{T.pakketten}</span>
            <span class="tab"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>{T.account}</span>
          </div>
        </div>
        <div class="mail" aria-hidden="true"><div class="van">{T.winkel}</div><div>{T.mailOnd}</div><div class="ond">{T.product} · {T.bedrag}</div></div>
      </div>

      <p class="bijschrift" id="oa-bijschrift" aria-live="polite">{T.teksten[0]}</p>
      <div class="bediening">
        {[1, 2, 3, 4, 5, 6].map((n) => <button class="balk" data-naar={n} aria-label={`${T.stap} ${n}`}><i></i></button>)}
        <button class="pauze" id="oa-pauze" aria-label={T.pauze}>❚❚</button>
      </div>
    </div>
</div>

<style is:global>
/* Staat in de held van de homepage. Desktop: rechts naast de tekst, meteen in beeld.
   Mobiel (Joël, 14 nov): eerst laten zien wat OEPS! is, dan pas aanmelden. Volgorde: kop, uitleg, animatie, formulier, bon. */
.oa-blok { grid-column: 2; grid-row: 1; min-width: 0; }
.oa-blok h2 { display: none; }
@media (max-width: 800px) {
  .hero.hero { gap: 0; }
  .hero > div:first-child { display: contents; }
  .hero > div:first-child > :not(h1):not(.lead) { order: 2; }
  .hero > .oa-blok { grid-column: auto; grid-row: auto; order: 1; margin: 4px 0 36px; }
  .hero > .bon.bon { order: 3; margin-top: 36px; }
}
.oa { --oa-grond:#EDEFF2; --oa-grijs:#4A5568; --oa-lijn:#C9CED6; --oa-mint:#2E9E6E; --oa-mintzacht:#E3F4EC; --oa-kop:'Archivo',system-ui,sans-serif; --oa-mono:'IBM Plex Mono',ui-monospace,monospace; font-family:var(--oa-kop); color:var(--marine); line-height:1.5; }

.oa p, .oa h3 { margin:0; }

/* ---------- podium met telefoon ---------- */
.oa { position: relative; display: grid; justify-items: center; gap: 14px; }
.oa .telefoon { position: relative; width: 300px; max-width: 100%; aspect-ratio: 300 / 610; background: var(--marine); border-radius: 46px; padding: 11px; box-sizing: border-box; box-shadow: 0 30px 60px -30px rgba(20,33,61,.45); }
.oa .scherm { position: relative; height: 100%; background: var(--oa-grond); border-radius: 36px; overflow: hidden; }
.oa .status { position: absolute; inset: 0 0 auto; height: 44px; display: flex; align-items: center; justify-content: space-between; padding: 0 22px; font: 600 13px var(--oa-kop); z-index: 3; }
.oa .datum { font: 500 12px var(--oa-mono); background: var(--wit); border: 2px solid var(--marine); border-radius: 999px; padding: 2px 10px; }
.oa .datum.flip { animation: flip .5s ease; }
@keyframes flip {0% { transform: rotateX(90deg); }
100% { transform: none; }
 }
.oa .sc { position: absolute; inset: 52px 14px 74px; display: grid; align-content: start; gap: 10px; opacity: 0; visibility: hidden; transition: opacity .35s; }
.oa[data-scene="inbox"] .scA, .oa[data-scene="kaart"] .sc1, .oa[data-scene="vlakken"] .scB, .oa[data-scene="seintje"] .sc2, .oa[data-scene="garantie"] .sc3, .oa[data-scene="overzicht"] .sc4 { opacity: 1; visibility: visible; }
.oa .sc h3 { font-size: 26px; font-weight: 900; font-stretch: 115%; margin: 2px 2px 2px; }
.oa .oa-kaart { background: var(--wit); border-radius: 22px; padding: 14px 16px; display: grid; gap: 4px; position: relative; }
.oa .oa-kaart .wie { font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--oa-grijs); }
.oa .oa-kaart .wat { font-size: 19px; font-weight: 900; font-stretch: 110%; line-height: 1.15; }
.oa .rij { display: flex; justify-content: space-between; gap: 8px; font: 13px var(--oa-mono); }
.oa .rij b { font-weight: 500; }
.oa .grijsrij { height: 46px; background: var(--wit); border-radius: 18px; opacity: .55; }
.oa .nieuw { border: 2px solid var(--marine); }
.oa .prijs b { background: var(--geel); padding: 0 4px; border-radius: 4px; }
.oa .vraag { border-left: 6px solid var(--geel); }
.oa .vraag .kopje { display: flex; align-items: center; gap: 8px; font-size: 17px; font-weight: 900; }
.oa .vraag .kopje::before { content: ""; width: 12px; height: 12px; border-radius: 50%; background: var(--geel); flex: none; }
.oa .knoppen { display: flex; gap: 8px; margin-top: 8px; }
.oa .kn { flex: 1; min-height: 40px; border-radius: 999px; border: 2px solid var(--marine); background: var(--wit); font: 800 14px var(--oa-kop); color: var(--marine); display: grid; place-items: center; position: relative; }
.oa .klaar { position: absolute; inset: 0; border-radius: 22px; background: var(--oa-mintzacht); display: grid; place-items: center; text-align: center; font-weight: 900; font-size: 17px; padding: 12px; }
.oa .klaar span { display: block; font: 400 13px var(--oa-kop); color: var(--oa-grijs); margin-top: 4px; }
.oa .vinkje { width: 34px; height: 34px; border-radius: 50%; background: var(--oa-mint); color: var(--wit); display: grid; place-items: center; margin: 0 auto 6px; font-size: 20px; }
.oa .bel { background: var(--marine); color: var(--wit); border-radius: 18px 18px 18px 6px; padding: 10px 14px; font-size: 14px; line-height: 1.35; }
.oa .bel .kn { background: var(--geel); border-color: var(--geel); margin-top: 8px; min-height: 36px; }
.oa .stand { background: var(--marine); color: var(--wit); border-radius: 22px; padding: 14px 16px; display: grid; gap: 2px; }
.oa .stand .bedrag, .oa .bespaard .bedrag { font: 500 30px var(--oa-mono); }
.oa .bespaard { background: var(--geel); border-radius: 22px; padding: 14px 16px; display: grid; gap: 2px; }
.oa .oa-klein { font-size: 13px; }
.oa .tik { position: absolute; width: 34px; height: 34px; border-radius: 50%; background: rgba(20,33,61,.25); border: 2px solid var(--marine); pointer-events: none; opacity: 0; left: 50%; top: 50%; margin: -17px 0 0 -17px; }


/* scène mailbox en scène vlakken */
.oa .mrij { background: var(--wit); border-radius: 16px; padding: 8px 12px; display: grid; grid-template-columns: 1fr auto; gap: 0 8px; align-items: center; font-size: 12px; border: 2px solid transparent; }
.oa .mrij b { font-size: 13px; }
.oa .mrij .ond { grid-column: 1; color: var(--oa-grijs); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.oa .mrij .tag { grid-row: 1 / 3; grid-column: 2; font: 500 11px var(--oa-mono); background: var(--geel); border-radius: 999px; padding: 3px 8px; }
.oa .mrij.pak { border-color: var(--marine); }
.oa .mrij.laat { opacity: .4; }
.oa .tegels { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.oa .tegel { background: var(--wit); border: 2px solid var(--marine); border-radius: 18px; padding: 10px; display: grid; gap: 2px; align-content: start; }
.oa .tegel .wie { font-size: 10px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--oa-grijs); }
.oa .tegel b { font-size: 13px; line-height: 1.2; }
.oa.speel .mrij { animation: kaartIn .35s both; }
.oa.speel .mrij:nth-child(2) { animation-delay: .1s; }
.oa.speel .mrij:nth-child(3) { animation-delay: .2s; }
.oa.speel .mrij:nth-child(4) { animation-delay: .3s; }
.oa.speel .mrij:nth-child(5) { animation-delay: .4s; }
.oa.speel .mrij:nth-child(6) { animation-delay: .5s; }
.oa.speel .mrij:nth-child(7) { animation-delay: .6s; }
.oa.speel .mrij.laat { animation: laat .5s 1.3s both; }
@keyframes laat {from { opacity: 1; }
to { opacity: .4; }
 }
.oa.speel .mrij.pak { animation: pak .4s 1.5s both; }
@keyframes pak {from { border-color: transparent; }
to { border-color: var(--marine); }
 }
.oa.speel .mrij .tag { animation: kaartIn .35s 1.8s cubic-bezier(.2,.8,.3,1.4) both; }
.oa.speel .tegel { animation: kaartIn .4s cubic-bezier(.2,.8,.3,1.3) both; }
.oa.speel .tegel:nth-child(1) { animation-delay: .2s; }
.oa.speel .tegel:nth-child(2) { animation-delay: .5s; }
.oa.speel .tegel:nth-child(3) { animation-delay: .8s; }
.oa.speel .tegel:nth-child(4) { animation-delay: 1.1s; }
.oa.speel .tegel:nth-child(5) { animation-delay: 1.4s; }
.oa.speel .tegel:nth-child(6) { animation-delay: 1.7s; }


/* tabbalk */
.oa .tabs { position: absolute; inset: auto 0 0; height: 66px; background: var(--wit); display: grid; grid-template-columns: repeat(4, 1fr); padding-bottom: 6px; z-index: 3; }
.oa .tab { display: grid; justify-items: center; align-content: center; gap: 2px; font-size: 10px; color: var(--oa-grijs); }
.oa .tab svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.oa[data-scene="inbox"] .tabs { visibility: hidden; }
.oa[data-scene="vlakken"] .t-nu, .oa[data-scene="seintje"] .t-nu, .oa[data-scene="garantie"] .t-nu, .oa[data-scene="kaart"] .t-ov, .oa[data-scene="overzicht"] .t-ov { color: var(--marine); font-weight: 800; }


/* de mail die binnenkomt (buiten de telefoon) */
.oa .mail { position: absolute; top: 8px; left: -40px; width: 230px; background: var(--wit); border: 2px solid var(--marine); border-radius: 18px; padding: 10px 12px; z-index: 5; box-shadow: 0 14px 30px -18px rgba(20,33,61,.5); opacity: 0; font-size: 13px; }
.oa .mail .van { font-weight: 800; }
.oa .mail .ond { color: var(--oa-grijs); }
@media (max-width: 420px) {.oa .mail { left: -14px; width: 200px; }
 }


/* bijschrift + bediening */
.oa .bijschrift { min-height: 48px; text-align: center; font-weight: 800; font-size: 17px; max-width: 32ch; }
.oa .bediening { display: flex; align-items: center; gap: 10px; }
.oa .balk { width: 26px; height: 8px; border-radius: 999px; background: var(--wit); border: 2px solid var(--marine); overflow: hidden; padding: 0; cursor: pointer; }
.oa .balk i { display: block; height: 100%; width: 0; background: var(--marine); }
.oa .pauze { width: 40px; height: 40px; border-radius: 50%; border: 2px solid var(--marine); background: var(--wit); color: var(--marine); display: grid; place-items: center; cursor: pointer; font: 800 14px var(--oa-kop); }
.oa .balk:focus-visible, .oa .pauze:focus-visible, .oa .knop:focus-visible { outline: 3px solid var(--geel); outline-offset: 3px; }


/* ---------- animaties (standaard = eindbeeld; animaties komen van "verborgen" naar dat beeld) ---------- */
.oa[data-scene="kaart"].speel .mail { animation: mailIn 3.2s ease both; }
@keyframes mailIn {0% { opacity: 0; transform: translateY(-30px) rotate(-3deg); }
12% { opacity: 1; transform: rotate(-3deg); }
55% { opacity: 1; transform: rotate(-3deg); }
80%, 100% { opacity: 0; transform: translate(40px, 60px) scale(.7) rotate(0); }
 }
.oa.speel .nieuw { animation: kaartIn .5s .6s cubic-bezier(.2,.8,.3,1.2) both; }
@keyframes kaartIn {from { opacity: 0; transform: scale(.92); }
to { opacity: 1; transform: none; }
 }
.oa.speel .veld { animation: vlieg .55s cubic-bezier(.2,.8,.3,1.15) both; }
.oa.speel .v1 { animation-delay: 1.0s; }
.oa.speel .v2 { animation-delay: 1.35s; }
.oa.speel .v3 { animation-delay: 1.7s; }
.oa.speel .v4 { animation-delay: 2.05s; }
.oa.speel .v5 { animation-delay: 2.4s; }
@keyframes vlieg {from { opacity: 0; transform: translate(-70px, -90px) rotate(-8deg) scale(.85); }
to { opacity: 1; transform: none; }
 }
.oa.speel .vraag { animation: kaartIn .45s .2s cubic-bezier(.2,.8,.3,1.2) both; }
.oa.speel .tik { animation: tik .7s ease both; }
.oa.speel .sc2 .tik { animation-delay: 1.7s; }
.oa.speel .sc3 .tik { animation-delay: 1.6s; }
@keyframes tik {0% { opacity: 0; transform: scale(1.8); }
40% { opacity: 1; transform: scale(1); }
100% { opacity: 0; transform: scale(.9); }
 }
.oa.speel .sc2 .gekozen, .oa.speel .sc3 .gekozen { animation: druk .3s 1.95s both; }
.oa .sc2 .gekozen, .oa .sc3 .gekozen { background: var(--marine); color: var(--wit); }
@keyframes druk {from { background: var(--wit); color: var(--marine); }
to { background: var(--marine); color: var(--wit); }
 }
.oa.speel .klaar { animation: verschijn .4s 2.4s both; }
.oa.speel .bel { animation: kaartIn .45s 2.3s cubic-bezier(.2,.8,.3,1.2) both; }
@keyframes verschijn {from { opacity: 0; }
to { opacity: 1; }
 }
.oa.speel .stand { animation: kaartIn .45s .1s both; }
.oa.speel .bespaard { animation: kaartIn .45s .5s cubic-bezier(.2,.8,.3,1.2) both; }
.oa.speel .rustig { animation: verschijn .5s 1.6s both; }
.oa.gepauzeerd *, .oa.gepauzeerd *::before { animation-play-state: paused !important; }
@media (prefers-reduced-motion: reduce) {.oa *, .oa *::before { animation: none !important; transition: none !important; }
 }



</style>

<script is:inline>
(() => {
  const podium = document.getElementById('oa-podium'); if (!podium) return;
  const D = JSON.parse(podium.dataset.js);
  const datum = document.getElementById('oa-datum');
  const bijschrift = document.getElementById('oa-bijschrift');
  const teller = document.getElementById('oa-teller');
  const balken = [...podium.querySelectorAll('.balk i')];
  const pauzeKnop = document.getElementById('oa-pauze');
  const DUUR = 3600;
  const SCENES = ['inbox', 'kaart', 'vlakken', 'seintje', 'garantie', 'overzicht'];
  const stil = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let scene = 0, start = 0, verstreken = 0, gepauzeerd = stil, timers = [], inBeeld = true;

  const zetDatum = (t) => { datum.textContent = t; datum.classList.remove('flip'); void datum.offsetWidth; datum.classList.add('flip'); };
  const na = (ms, fn) => timers.push(setTimeout(fn, ms));
  const geld = (n) => '€' + n.toFixed(2).replace('.', D.komma);
  function speel(n) {
    timers.forEach(clearTimeout); timers = [];
    scene = n; verstreken = 0; start = performance.now();
    const naam = SCENES[n];
    podium.dataset.scene = naam;
    podium.classList.remove('speel'); void podium.offsetWidth; if (!stil) podium.classList.add('speel');
    bijschrift.textContent = D.teksten[n];
    balken.forEach((b, i) => { b.style.width = i < n ? '100%' : '0'; });
    if (naam === 'inbox' || naam === 'kaart' || naam === 'vlakken') zetDatum(D.datums.start);
    if (naam === 'seintje') {
      if (stil) zetDatum(D.datums.loop[D.datums.loop.length - 1]); else D.datums.loop.forEach((d, i) => na(120 + i * 170, () => zetDatum(d)));
    }
    if (naam === 'garantie') zetDatum(D.datums.later);
    if (naam === 'overzicht') {
      zetDatum(D.datums.nu);
      if (!stil) {
        const doel = 231.36, t0 = performance.now() + 500;
        const stap = (t) => {
          const p = Math.min(1, Math.max(0, (t - t0) / 1200));
          teller.textContent = geld(doel * (1 - Math.pow(1 - p, 3)));
          if (p < 1 && SCENES[scene] === 'overzicht') requestAnimationFrame(stap);
        };
        teller.textContent = geld(0); requestAnimationFrame(stap);
      }
    }
  }
  function klok(t) {
    if (!gepauzeerd && inBeeld) {
      verstreken = t - start;
      if (balken[scene]) balken[scene].style.width = Math.min(100, verstreken / DUUR * 100) + '%';
      if (verstreken >= DUUR) speel((scene + 1) % SCENES.length);
    } else if (!gepauzeerd) start = t - verstreken;
    requestAnimationFrame(klok);
  }
  function zetPauze(aan) {
    gepauzeerd = aan;
    podium.classList.toggle('gepauzeerd', aan);
    pauzeKnop.textContent = aan ? '▶' : '❚❚';
    pauzeKnop.setAttribute('aria-label', aan ? D.afspelen : D.pauze);
    if (!aan) start = performance.now() - verstreken;
  }
  pauzeKnop.onclick = () => zetPauze(!gepauzeerd);
  podium.querySelectorAll('.balk').forEach((b) => b.onclick = () => { speel(+b.dataset.naar - 1); });
  // Pas afspelen als de telefoon in beeld is, zodat je het begin niet mist.
  if ('IntersectionObserver' in window) {
    inBeeld = false;
    new IntersectionObserver((e) => { const zicht = e[0].isIntersecting; if (zicht && !inBeeld && !gepauzeerd) speel(scene); inBeeld = zicht; }, { threshold: 0.4 }).observe(podium);
  }
  speel(0);
  if (stil) zetPauze(true);
  requestAnimationFrame(klok);
})();
</script>
