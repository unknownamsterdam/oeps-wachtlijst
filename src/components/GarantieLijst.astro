---
// Garantie-overzicht, Nederlands (/garantie/) of Engels (/en/warranty/). 22 okt: teksten per taal.
import Base from '../layouts/Base.astro';
import Wachtlijst from './Wachtlijst.astro';
import { GARANTIE, GARANTIE_EN, WET, WET_EN, WET_BRON, garantiePad } from '../data/garantie.js';
import { PAD, tegenhanger } from '../i18n.js';
const { taal = 'nl' } = Astro.props;
const en = taal === 'en';
const lijst = (en ? GARANTIE_EN : GARANTIE).slice().sort((a, b) => a.naam.localeCompare(b.naam, taal));
const X = en ? {
  titel: 'Warranty per shop in the Netherlands: bol, Coolblue, Wehkamp, IKEA and more | OEPS!',
  beschrijving: 'How long is the warranty at bol, Coolblue, Wehkamp, IKEA, Gamma and other Dutch shops, and how do you claim it? Per shop: the duration, the steps and what you need, in English.',
  h1: 'Warranty per shop', sub: 'Per shop: how long your warranty lasts, how to claim it and what you need.', voorbij: 'Warranty over, now what?', item: (g) => `${g.naam} warranty`,
  wet: 'What Dutch law says', bron: 'Source', bronNaam: 'Government of the Netherlands (Dutch)', advies: 'General information, not legal advice.',
  oepsKop: 'Rather not remember?', oeps: 'OEPS! remembers the warranty of all your purchases and warns you in time.', wetLijst: WET_EN,
} : {
  titel: 'Garantie per winkel: bol, Coolblue, Wehkamp, IKEA en meer | OEPS!',
  beschrijving: 'Hoe lang heb je garantie bij bol, Coolblue, Wehkamp, IKEA, Gamma en andere winkels en hoe claim je die? Per winkel de duur, de stappen en wat je nodig hebt.',
  h1: 'Garantie per winkel', sub: 'Per winkel: hoe lang je garantie hebt, hoe je die claimt en wat je nodig hebt.', voorbij: 'Garantie voorbij, wat nu?', item: (g) => `Garantie ${g.naam}`,
  wet: 'Wat de wet zegt', bron: 'Bron', bronNaam: 'Rijksoverheid', advies: 'Algemene informatie, geen juridisch advies.',
  oepsKop: 'Liever niet onthouden?', oeps: 'OEPS! onthoudt de garantie van al je aankopen en waarschuwt je op tijd.', wetLijst: WET,
};
---
<Base title={X.titel} description={X.beschrijving} taal={taal} andere={tegenhanger(taal, 'garantie')}>
  <div class="kopblok bg-perzik"><div class="wrap smal"><h1>{X.h1}</h1><p class="sub">{X.sub}</p></div></div>
  <div class="wrap smal">
    <a class="mini uitgelicht" href={PAD[taal].voorbij}><span>{X.voorbij}</span></a>
    <div class="lijst" style="margin-top:10px">{lijst.map((g) => <a class="mini" href={garantiePad(g.slug, taal)}><span>{X.item(g)}</span></a>)}</div>
    <section class="wettig"><h2>{X.wet}</h2><ul>{X.wetLijst.map((x) => <li>{x}</li>)}</ul><p class="klein">{X.bron}: <a href={WET_BRON} rel="noopener nofollow" target="_blank">{X.bronNaam}</a>. {X.advies}</p></section>
    <aside class="oeps"><h2>{X.oepsKop}</h2><p>{X.oeps}</p><Wachtlijst compact bron="garantie-lijst" taal={taal} /></aside>
  </div>
</Base>
<style>
  .kopblok{padding:28px 0 40px;margin-bottom:-18px}
  .kopblok h1{font-size:clamp(32px,5.4vw,50px)}
  .sub{font-size:18px;margin-top:8px}
  .lijst{display:grid;gap:10px}
  .mini{display:flex;justify-content:space-between;gap:12px;padding:14px 16px;border-radius:16px;background:var(--wit);text-decoration:none;font-weight:700;font-size:17px;box-shadow:var(--schaduw)}
  .uitgelicht{background:var(--geel);border:3px solid var(--marine)}
  .wettig{margin-top:32px;font-size:17px}
  .wettig ul{margin-top:12px;display:grid;gap:10px;list-style:none}
  .wettig li{background:var(--wit);border-radius:14px;padding:12px 16px}
  .oeps{margin-top:32px;background:var(--marine);color:var(--wit);border-radius:var(--rond);padding:24px;display:grid;gap:12px}
  .oeps h2{color:var(--wit)}
  .oeps p{color:#d6dbe5}
  .oeps :global(label){color:var(--wit)}
  .oeps :global(.formulier button){background:var(--geel);color:var(--marine)}
</style>
