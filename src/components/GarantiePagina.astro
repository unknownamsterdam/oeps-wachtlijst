---
// 20 okt: garantiepagina per winkel, uit src/data/garantie.js. 22 okt: ook in het Engels (/en/warranty/<slug>/).
import Base from '../layouts/Base.astro';
import Plaatje from './Plaatje.astro';
import Wachtlijst from './Wachtlijst.astro';
import AppBalk from './AppBalk.astro';
import { SITE } from '../data/site.js';
import { GARANTIE, GARANTIE_EN, WET, WET_EN, WET_BRON, garantiePad, heeftEngelseGarantie } from '../data/garantie.js';
import { RETOUR, RETOUR_EN, gidsPad } from '../data/gids.js';
import { PAD, TEKST, datum } from '../i18n.js';

const { g, taal = 'nl' } = Astro.props;
const en = taal === 'en';
const T = TEKST[taal];
const pad = garantiePad(g.slug, taal);
const andere = en ? garantiePad(g.slug, 'nl') : (heeftEngelseGarantie(g.slug) ? garantiePad(g.slug, 'en') : null);
const X = en ? {
  titel: `${g.naam} warranty`, seoTitel: `${g.naam} warranty: how long, and how do you claim it? | OEPS!`,
  beschrijving: `How long is the warranty at ${g.naam}, how do you claim it and what do you need? Duration, steps and what isn’t covered, with source and date.`,
  v1: `How long is the warranty at ${g.naam}?`, v2: `How do you claim warranty at ${g.naam}?`, v3: `What do you need to claim warranty at ${g.naam}?`, v4: `What isn’t covered by the ${g.naam} warranty?`,
  kruimel: 'Warranty', hoeLang: 'How long is the warranty?', claim: 'How to claim warranty', nodig: 'What do you need?',
  tipKop: 'Lost your receipt?', tip: 'OEPS! keeps your receipts and remembers the warranty of every purchase.',
  niet: 'What isn’t covered?', letop: 'Good to know', wet: 'Your legal rights (Dutch law)', wetBron: 'Government of the Netherlands (Dutch)',
  voorbij: 'Warranty over and still broken? Read what you can do ›', retour: `Also handy: the ${g.naam} return period ›`,
  blokKop: 'Never miss a warranty again.', blok: 'OEPS! remembers the warranty of every purchase and gives you a nudge before it ends. You don’t have to keep track of anything.',
  meer: 'Warranty at other shops', mini: (x) => `${x.naam} warranty`, balk: 'Never lose your receipt or warranty again?',
  nlKnoppen: `${g.naam}’s website and customer service are in Dutch. Where a menu or button is named, the English meaning is in brackets.`,
} : {
  titel: `Garantie ${g.naam}`, seoTitel: `Garantie ${g.naam}: hoe lang en hoe claim je? | OEPS!`,
  beschrijving: `Hoe lang heb je garantie bij ${g.naam}, hoe claim je het en wat heb je nodig? Duur, stappen en wat niet gedekt is, met bron en datum.`,
  v1: `Hoe lang heb je garantie bij ${g.naam}?`, v2: `Hoe claim je garantie bij ${g.naam}?`, v3: `Wat heb je nodig om garantie te claimen bij ${g.naam}?`, v4: `Wat valt niet onder de garantie van ${g.naam}?`,
  kruimel: 'Garantie', hoeLang: 'Hoe lang heb je garantie?', claim: 'Zo claim je garantie', nodig: 'Wat heb je nodig?',
  tipKop: 'Kassabon kwijt?', tip: 'OEPS! bewaart je bonnen en onthoudt de garantie van elke aankoop.',
  niet: 'Wat valt er niet onder?', letop: 'Goed om te weten', wet: 'Je wettelijke recht', wetBron: 'Rijksoverheid',
  voorbij: 'Garantie voorbij en toch kapot? Lees wat je kunt doen ›', retour: `Ook handig: de retourtermijn van ${g.naam} ›`,
  blokKop: 'Nooit meer garantie missen.', blok: 'OEPS! onthoudt de garantie van elke aankoop en geeft je een seintje voordat hij afloopt. Jij hoeft niets bij te houden.',
  meer: 'Garantie bij andere winkels', mini: (x) => `Garantie ${x.naam}`, balk: 'Nooit meer je kassabon of garantie kwijt?',
  nlKnoppen: null,
};
const { titel, seoTitel, beschrijving } = X;
const gecontroleerd = datum(g.bijgewerkt, taal);
const lijst = (a) => a.map((x) => x.replace(/\.$/, '') + '.').join(' ');
const faq = [
  { v: X.v1, a: lijst(g.duur) },
  { v: X.v2, a: g.stappen.map((x, i) => `${i + 1}. ${x.replace(/\.$/, '')}.`).join(' ') },
  { v: X.v3, a: lijst(g.nodig) },
  { v: X.v4, a: lijst(g.niet) },
];
const wet = en ? WET_EN : WET;
const retourPagina = (en ? RETOUR_EN : RETOUR).find((x) => x.slug === g.slug);
const meer = (en ? GARANTIE_EN : GARANTIE).filter((x) => x.slug !== g.slug);
const lang = en ? 'en' : 'nl-NL';
const schema = [
  { '@type': 'WebPage', '@id': SITE.url + pad + '#pagina', url: SITE.url + pad, name: seoTitel.replace(' | OEPS!', ''), description: beschrijving, inLanguage: lang, dateModified: g.bijgewerkt, isPartOf: { '@id': SITE.url + '/#website' }, publisher: { '@id': SITE.url + '/#organization' } },
  { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.v, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + PAD[taal].home },
    { '@type': 'ListItem', position: 2, name: X.kruimel, item: SITE.url + PAD[taal].garantie },
    { '@type': 'ListItem', position: 3, name: titel, item: SITE.url + pad } ] },
];
---
<Base title={seoTitel} description={beschrijving} schema={schema} taal={taal} andere={andere}>
  <article class="gids">
    <div class="kopblok bg-perzik">
      <div class="wrap smal kopblok-in">
        <div>
          <nav class="kruimel" aria-label={T.kruimel}><a href={PAD[taal].garantie}>{X.kruimel}</a> <span>›</span> {g.naam}</nav>
          <h1>{titel}</h1>
        </div>
        <Plaatje naam="wasmachine" grootte={130} />
      </div>
    </div>
    <div class="wrap smal">
      <div class="kort"><span class="kort-label">{T.kortGezegd}</span><p>{g.kort}</p><p class="gecontroleerd">{T.gecontroleerdOp} {gecontroleerd} · {T.bron}: <a href={g.bron} rel="noopener nofollow" target="_blank">{T.siteVan(g.naam)}</a></p></div>
      <section class="tekst"><h2>{X.hoeLang}</h2><ul>{g.duur.map((x) => <li>{x}</li>)}</ul></section>
      <section class="tekst"><h2>{X.claim}</h2><ol>{g.stappen.map((x) => <li>{x}</li>)}</ol>{X.nlKnoppen && <p class="wet">{X.nlKnoppen}</p>}</section>
      <section class="tekst"><h2>{X.nodig}</h2><ul>{g.nodig.map((x) => <li>{x}</li>)}</ul></section>
      <p class="tip"><b>{X.tipKop}</b> {X.tip} <a href={PAD[taal].aanmelden}>{T.start} ›</a></p>
      <section class="tekst"><h2>{X.niet}</h2><ul>{g.niet.map((x) => <li>{x}</li>)}</ul></section>
      {g.letop.length > 0 && (<section class="tekst"><h2>{X.letop}</h2><ul>{g.letop.map((x) => <li>{x}</li>)}</ul></section>)}
      <section class="tekst"><h2>{X.wet}</h2><ul>{wet.map((x) => <li>{x}</li>)}</ul><p class="wet">{en ? 'Source' : 'Bron'}: <a href={WET_BRON} rel="noopener nofollow" target="_blank">{X.wetBron}</a></p></section>
      <section class="tekst vragen"><h2>{T.veelgesteld}</h2>
        {faq.map((f) => (<details><summary>{f.v}</summary><p>{f.a}</p></details>))}
      </section>
      <p class="naar"><a href={PAD[taal].voorbij}>{X.voorbij}</a></p>
      {retourPagina && <p class="naar"><a href={gidsPad('retour', g.slug, taal)}>{X.retour}</a></p>}
      <aside class="oeps-blok">
        <div><span class="badge">{T.binnenkort}</span>
          <h2>{X.blokKop}</h2>
          <p>{X.blok}</p></div>
        <Wachtlijst compact bron={'garantie-' + g.slug} taal={taal} />
      </aside>
      <footer class="info">
        <p>{T.opgezocht(g.naam)} · {T.bijgewerktOp} {gecontroleerd} · <a href={g.bron} rel="noopener nofollow" target="_blank">{T.bron}</a></p>
        <p>{T.kloptNiet} <a href={`mailto:${SITE.mail}`}>{SITE.mail}</a>, {T.kloptNiet2(g.naam)}</p>
      </footer>
      {meer.length > 0 && (<section class="meer"><h2>{X.meer}</h2>
        <div class="meer-lijst">{meer.map((x) => <a class="mini" href={garantiePad(x.slug, taal)}>{X.mini(x)}</a>)}</div></section>)}
    </div>
  </article>
<AppBalk tekst={X.balk} />
</Base>
<style>
  .kopblok{padding:28px 0 46px;margin-bottom:-22px}
  .kopblok-in{display:flex;align-items:center;gap:20px;justify-content:space-between}
  .kopblok h1{font-size:clamp(32px,5.4vw,50px)}
  .kruimel{font-size:14px;font-weight:600;margin-bottom:12px}
  .kruimel a{text-decoration:none;opacity:.8}
  .kruimel span{opacity:.5;margin:0 4px}
  .kort{position:relative;background:var(--wit);border-radius:var(--rond);box-shadow:var(--schaduw);padding:24px 24px 22px;border:3px solid var(--marine)}
  .kort-label{position:absolute;top:-14px;left:20px;background:var(--geel);font-weight:800;font-stretch:112%;font-size:14px;padding:3px 12px;border-radius:999px;border:3px solid var(--marine)}
  .kort p{font-size:20px;line-height:1.45;font-weight:600}
  .tekst{margin-top:32px;font-size:18px}
  .tekst h2{margin:0 0 12px}
  .tekst ol,.tekst ul{margin:12px 0;padding-left:0;list-style:none;display:grid;gap:10px}
  .tekst li{background:var(--wit);border-radius:14px;padding:12px 16px 12px 48px;position:relative}
  .tekst ul li::before{content:"";position:absolute;left:18px;top:19px;width:12px;height:12px;border-radius:50%;background:var(--geel);border:2.5px solid var(--marine)}
  .tekst ol{counter-reset:stap}
  .tekst ol li{counter-increment:stap}
  .tekst ol li::before{content:counter(stap);position:absolute;left:12px;top:11px;width:26px;height:26px;border-radius:50%;background:var(--marine);color:var(--wit);font-weight:800;font-size:14px;display:grid;place-items:center}
  .naar{margin-top:18px;font-weight:700}
  .kort .gecontroleerd{font-size:14px;font-weight:500;color:var(--zacht);margin-top:10px}
  .vragen details{background:var(--wit);border-radius:14px;padding:0;margin-top:10px}
  .vragen summary{cursor:pointer;font-weight:700;padding:14px 18px;list-style:none;font-size:17px}
  .vragen summary::-webkit-details-marker{display:none}
  .vragen summary::after{content:"+";float:right;font-weight:800}
  .vragen details[open] summary::after{content:"–"}
  .vragen details p{padding:0 18px 16px;font-size:16px;color:var(--zacht)}
  .tip{margin-top:22px;background:var(--mint);border-radius:var(--rond);padding:16px 18px;font-size:16px}
  .tip a{font-weight:800;white-space:nowrap}
  .wet{margin-top:14px;font-size:15px;color:var(--zacht)}
  .tekst ul.zacht li{background:var(--wit)}
  .oeps-blok{margin:28px 0 0;background:var(--marine);color:var(--wit);border-radius:var(--rond);padding:26px;display:grid;gap:18px}
  .oeps-blok h2{color:var(--wit);margin:10px 0 6px}
  .oeps-blok p{color:#d6dbe5}
  .badge{display:inline-block;background:var(--geel);color:var(--marine);font-weight:800;font-size:13px;padding:3px 10px;border-radius:999px}
  .oeps-blok :global(label){color:var(--wit)}
  .oeps-blok :global(.klein){color:#aab3c5}
  .oeps-blok :global(.formulier button){background:var(--geel);color:var(--marine)}
  .info{margin-top:30px;font-size:14px;color:var(--zacht);display:grid;gap:4px}
  .meer{margin-top:40px}
  .meer h2{margin-bottom:14px}
  .meer-lijst{display:grid;gap:10px}
  .mini{display:block;padding:12px 16px;border-radius:16px;background:var(--wit);text-decoration:none;font-weight:700;font-size:17px}
  @media (max-width:640px){.kopblok-in{flex-direction:column-reverse;align-items:flex-start;gap:4px}.kopblok :global(.plaatje){width:90px;height:90px}.tekst{font-size:17px}.kort p{font-size:18px}}
</style>
