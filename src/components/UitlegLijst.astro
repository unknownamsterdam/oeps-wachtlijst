---
// Overzicht van de uitleg, Nederlands (/hoe-zit-dat/) of Engels (/en/explained/). 22 okt: teksten per taal.
import Base from '../layouts/Base.astro';
import Plaatje from './Plaatje.astro';
import Wachtlijst from './Wachtlijst.astro';
import { SITE } from '../data/site.js';
import { vragenPerOnderwerp } from '../data/vragen.js';
import { PAD, tegenhanger } from '../i18n.js';

const { taal = 'nl' } = Astro.props;
const X = {
  nl: {
    titel: 'Hoe zit dat? Retour, garantie, abonnementen en prijzen simpel uitgelegd | OEPS!',
    beschrijving: 'Hoe lang mag je iets terugsturen? Wanneer mag je opzeggen? Wat als iets kapotgaat? Korte, simpele antwoorden op vragen over je huishouden.',
    kruimel: 'Hoe zit dat?', sticker: 'Simpel uitgelegd', h1a: 'Hoe zit', h1b: 'dat?',
    lead: 'Terugsturen, garantie, opzeggen, duurder worden. Je hebt vaak meer rechten dan je denkt. Hier lees je hoe het zit, in gewone taal.',
    onderKop: 'Liever niet alles zelf onthouden?',
    onder: 'OEPS! houdt straks je retourdagen, garanties, opzegtermijnen en prijzen voor je bij. Probeer het gratis, je bent zo binnen.',
  },
  en: {
    titel: 'Know your rights: returns, warranty, subscriptions and prices in the Netherlands, simply explained | OEPS!',
    beschrijving: 'How long can you send something back? When can you cancel? What if something breaks? Short, simple answers about Dutch consumer rights, in English.',
    kruimel: 'Know your rights', sticker: 'Simply explained', h1a: 'Know your', h1b: 'rights',
    lead: 'Sending things back, warranty, cancelling, prices going up. You often have more rights than you think. Here is how it works in the Netherlands, in plain English.',
    onderKop: 'Rather not remember it all yourself?',
    onder: 'OEPS! keeps track of your return days, warranties, notice periods and prices for you. Try it for free, you’re in within a minute.',
  },
}[taal];
const groepen = vragenPerOnderwerp(taal);
const schema = [{
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + PAD[taal].home },
    { '@type': 'ListItem', position: 2, name: X.kruimel, item: SITE.url + PAD[taal].uitleg },
  ],
}];
---
<Base title={X.titel} description={X.beschrijving} schema={schema} taal={taal} andere={tegenhanger(taal, 'uitleg')}>
  <section class="intro">
    <div class="wrap">
      <span class="sticker">{X.sticker}</span>
      <h1>{X.h1a} <mark>{X.h1b}</mark></h1>
      <p class="lead">{X.lead}</p>
    </div>
  </section>

  <div class="wrap">
    {groepen.map((g) => (
      <section class="groep" id={g.sleutel}>
        <div class={`groep-kop bg-${g.kleur}`}>
          <Plaatje naam={g.plaatje} grootte={88} />
          <div>
            <h2>{g.naam}</h2>
            <p>{g.kort}</p>
          </div>
        </div>
        <ul class="vragen">
          {g.vragen.map((v) => (
            <li><a href={v.url}><span>{v.titel}</span><span class="pijl" aria-hidden="true">→</span></a></li>
          ))}
        </ul>
      </section>
    ))}

    <section class="onderaan">
      <div>
        <h2>{X.onderKop}</h2>
        <p>{X.onder}</p>
      </div>
      <Wachtlijst compact bron="hoe-zit-dat" taal={taal} />
    </section>
  </div>
</Base>

<style>
  .intro{padding:36px 0 28px}
  .sticker{display:inline-block;background:var(--wit);border:3px solid var(--marine);border-radius:999px;font-weight:800;font-size:14px;padding:4px 12px;transform:rotate(-2deg);margin-bottom:14px}
  .lead{font-size:20px;color:var(--zacht);max-width:34em;margin-top:14px}
  .groep{display:grid;grid-template-columns:320px 1fr;gap:16px;margin-top:22px;scroll-margin-top:90px}
  .groep-kop{display:flex;gap:14px;align-items:center;border-radius:var(--rond);padding:18px}
  .groep-kop h2{font-size:24px}
  .groep-kop p{color:var(--zacht);font-size:15px}
  .vragen{list-style:none;display:grid;gap:10px;align-content:start}
  .vragen a{display:flex;align-items:center;justify-content:space-between;gap:12px;background:var(--wit);border-radius:18px;padding:18px 20px;text-decoration:none;font-weight:700;font-size:19px;box-shadow:var(--schaduw)}
  .vragen a:hover .pijl{transform:translateX(4px)}
  .pijl{font-size:22px;transition:transform .15s}
  .onderaan{margin-top:48px;background:var(--geel);border-radius:var(--rond);padding:26px;display:grid;grid-template-columns:1fr 1fr;gap:22px;align-items:center}
  .onderaan p{margin-top:6px}
  @media (max-width:800px){
    .groep{grid-template-columns:1fr;gap:8px;margin-top:18px}
    .groep-kop{padding:10px 14px;gap:10px;border-radius:18px}
    .groep-kop :global(.plaatje){width:52px;height:52px}
    .groep-kop h2{font-size:19px;line-height:1.15}
    .groep-kop p{font-size:14px}
    .vragen a{padding:13px 16px;font-size:16px;border-radius:14px}
    .onderaan{grid-template-columns:1fr}
    .intro{padding:22px 0 8px}
    .lead{font-size:17px}
  }
</style>
