---
import GarantiePagina from '../../../components/GarantiePagina.astro';
import { GARANTIE_EN } from '../../../data/garantie.js';
export function getStaticPaths() { return GARANTIE_EN.map((g) => ({ params: { slug: g.slug }, props: { g } })); }
const { g } = Astro.props;
---
<GarantiePagina g={g} taal="en" />
