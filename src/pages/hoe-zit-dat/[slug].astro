---
import UitlegPagina from '../../components/UitlegPagina.astro';
import { VRAGEN } from '../../data/vragen.js';
export function getStaticPaths() { return VRAGEN.map((v) => ({ params: { slug: v.slug }, props: { vraag: v } })); }
const { vraag } = Astro.props;
---
<UitlegPagina vraag={vraag} taal="nl" />
